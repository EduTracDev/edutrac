doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Welcome Email
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        padding: 20px;
        border: 1px solid #dddddd;
      }
      .header {
        text-align: center;
        margin-bottom: 20px;
      }
  body
    .container
      .header
        h1 Welcome!
      p Hello #{name},
      p This is a request to reset! Please click the link below to proceed:
      p
        a(href=verificationUrl target="_blank") Verify Email
      p If you did not make make this request, please ignore this email.