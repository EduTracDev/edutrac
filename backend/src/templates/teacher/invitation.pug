doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Invitation to join 
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        padding: 20px;
        border: 1px solid #dddddd;
      }
      .header {
        text-align: center;
        margin-bottom: 20px;
      }
  body
    .container
      .header
        h1 Welcome!
      p Hello,
      p You have been invited to join Gracious Schools as a Teacher.:
      p
        a(href=verificationUrl target="_blank") Accept Invitation
      p This invitation link would expire in 1 day.